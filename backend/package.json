{
  "name": "panel-backend",
  "version": "0.1.0",
  "description": "Panel L.Y Solution — backend (squelette Phase 2B) : registre, appairage, bridge, manifest, auth",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "dev:account": "node src/scripts/dev-account.js",
    "test": "node ../tests/run-all.js",
    "test:config": "node ../tests/config.test.js",
    "test:registry": "node ../tests/registry.test.js",
    "test:persistence": "node ../tests/persistence.test.js",
    "test:domains": "node ../tests/domains.test.js",
    "test:deploy": "node ../tests/deploy.test.js",
    "test:diagnostic": "node ../tests/diagnostic.test.js",
    "test:supervision": "node ../tests/supervision.test.js",
    "test:live-refresh": "node --experimental-strip-types --import ../tests/helpers/registerFrontendLoader.mjs ../tests/live-refresh.test.js",
    "test:panel-ux": "node ../tests/panel-ux.test.js",
    "test:architecture": "node ../tests/architecture.test.js",
    "test:manifest": "node ../tests/manifest.test.js",
    "test:capabilities": "node ../tests/capabilities.test.js",
    "test:versions": "node ../tests/version-compatibility.test.js",
    "test:bridge-http": "node ../tests/bridge-http.test.js",
    "test:bridge-conformity": "node ../tests/bridge-conformity.test.js",
    "test:spec-drift": "node ../tests/spec-drift.check.mjs",
    "test:engine-drift": "node ../tests/engine-drift.check.mjs",
    "test:engine-governance": "node ../tests/engine-governance.test.js",
    "test:rollback": "node ../tests/deployment-rollback.test.js",
    "test:duplication-e2e": "node ../tests/duplication-e2e.test.js"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.21.0",
    "mongoose": "^8.24.1",
    "ssh2": "^1.17.0",
    "tldts": "^7.4.9",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.2.0"
  }
}
