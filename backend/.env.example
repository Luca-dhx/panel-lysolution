# ── Panel L.Y Solution · backend ─────────────────────────────────────────────
# Copier vers .env puis renseigner les valeurs. Les variables marquées
# (fail-closed) arrêtent le serveur si elles sont absentes ou invalides.
# Mêmes conventions que les projets vitrines (SB Auto 06).

# ==========================================================
# ENV
# ==========================================================
# TEST ou PROD — l'unique interrupteur d'environnement (fail-closed).
# TEST → base DB_TEST ; PROD → base DB_PROD. Aucune autre valeur acceptée.
ENV=TEST

# Port HTTP du backend
PORT=4100

# ==========================================================
# MONGODB
# ==========================================================
# URI commune aux deux environnements (fail-closed). Ne JAMAIS y encoder le
# nom de base : seul le nom de la base sélectionnée change selon ENV.
MONGODB_URI=mongodb://127.0.0.1:27017

# Seul le nom de la base sélectionnée change selon ENV.
DB_TEST=panel_test
DB_PROD=panel_prod

# ==========================================================
# JWT
# ==========================================================
# Secret de signature des JWT des utilisateurs du Panel (fail-closed).
# OBLIGATOIREMENT généré aléatoirement — un placeholder, un secret court
# (< 32 caractères) ou une valeur d'exemple connue REFUSE le démarrage.
# Générer :
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Règles :
#   - ne JAMAIS réutiliser le secret d'un autre projet ou d'un autre
#     déploiement : chaque déploiement possède le sien ;
#   - changer ce secret invalide toutes les sessions en cours (les
#     utilisateurs devront se reconnecter) — c'est le geste de rotation.
JWT_SECRET=GENERATE_A_SECURE_RANDOM_SECRET

# Durée de vie des JWT (fail-closed) — ex. 12h, 7d, 900 (secondes).
JWT_EXPIRES_IN=12h

# ==========================================================
# CHIFFREMENT DU PONT
# ==========================================================
# Clé maître AES-256-GCM, 64 caractères hexadécimaux (fail-closed) —
# chiffrement au repos des bridgeTokens sortants. Clé DISTINCTE de
# JWT_SECRET et propre à ce déploiement (jamais partagée avec un projet).
# Générer :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changer cette clé rend illisibles les copies chiffrées existantes : les
# projets devront être ré-appairés.
BRIDGE_ENCRYPTION_KEY=

# ==========================================================
# IDENTITÉ / DOMAINES / URLS
# ==========================================================
# Nom d'affichage du Panel (renvoyé aux projets au bootstrap).
PANEL_NAME=Panel L.Y Solution

# URL publique du backend du Panel — fallback d'environnement ; la valeur de
# référence vit dans la configuration système en base (voir
# docs/architecture/24_ENVIRONMENT_AND_DOMAINS.md). Renseignée par le
# déploiement (ex. https://panel.exemple.com).
PUBLIC_URL=http://localhost:4100

# Origines CORS STATIQUES supplémentaires (séparées par des virgules). Les
# origines dérivées de la configuration système en base s'y ajoutent
# automatiquement. En dev, le frontend passe par le proxy Vite : liste vide.
CORS_ORIGINS=

# ==========================================================
# SEED (compte DEV initial)
# ==========================================================
# Compte DEV créé au démarrage s'il n'existe AUCUN utilisateur. Un compte
# existant n'est jamais écrasé.
#
# ── EN TEST ──────────────────────────────────────────────────────────────
# Ces deux variables sont FACULTATIVES. Laissées vides, le Panel crée un
# compte de développement par défaut et l'annonce dans ses journaux :
#
#     dev@panel.local  /  panel-dev-local
#
# Un clone neuf est donc utilisable immédiatement. Renseignez-les pour vos
# propres identifiants.
#
# Mot de passe perdu sur une base déjà peuplée (le seed ne s'exécute plus) :
#     npm run dev:account
#     npm run dev:account -- moi@exemple.test monMotDePasse
#
# ── EN PROD ──────────────────────────────────────────────────────────────
# Ces deux variables sont OBLIGATOIRES si vous voulez un compte initial, et
# le démarrage est REFUSÉ si :
#   · l'adresse est un identifiant de développement connu ;
#   · le mot de passe est un mot de passe connu, ou fait moins de
#     12 caractères.
# Le compte de développement par défaut n'existe JAMAIS en PROD.
SEED_DEV_EMAIL=
SEED_DEV_PASSWORD=

# ==========================================================
# PONT (réglages)
# ==========================================================
# Intervalle attendu des heartbeats des projets, en secondes (défaut 300).
HEARTBEAT_INTERVAL_S=300

# Durée de vie d'un code d'appairage, en secondes (défaut 900).
PAIRING_CODE_TTL_S=900
