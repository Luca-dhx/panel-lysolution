# ── Panel L.Y Solution · backend ─────────────────────────────────────────────
# Copier vers .env puis renseigner les valeurs. Les variables marquées
# (fail-closed) arrêtent le serveur si elles sont absentes ou invalides.

# ENV applicatif du Panel : TEST ou PROD (fail-closed)
PANEL_ENV=TEST

# Port HTTP du backend
PANEL_PORT=4100

# Identité du Panel (renvoyée aux projets au bootstrap)
PANEL_NAME=Panel L.Y Solution
PANEL_PUBLIC_URL=

# Signature des JWT des utilisateurs du Panel (fail-closed)
PANEL_JWT_SECRET=

# Clé AES-256-GCM, 64 caractères hexadécimaux — chiffrement au repos des
# bridgeTokens (fail-closed). Générer : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PANEL_ENCRYPTION_KEY=

# Compte DEV seed (créé au démarrage s'il n'existe pas). Sans ces variables le
# serveur démarre mais aucune connexion n'est possible.
PANEL_SEED_DEV_EMAIL=
PANEL_SEED_DEV_PASSWORD=

# Intervalle attendu des heartbeats des projets, en secondes (défaut 300)
PANEL_HEARTBEAT_INTERVAL_S=300

# Durée de vie d'un code d'appairage, en secondes (défaut 900)
PANEL_PAIRING_CODE_TTL_S=900
